root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Der zurueckgewonnene Code ist mit Tabs eingerueckt, neuer Code bleibt dabei.
[*.cs]
indent_style = tab
indent_size = 4

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2
end_of_line = lf
